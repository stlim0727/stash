# Dependencies
node_modules/
.pnpm-store/

# Environment files
.env
.env.*
!.env.example

# Build outputs
.expo/
dist/
build/
coverage/

# Netlify CLI local state (web-preview skill). netlify.toml IS committed (it
# drives Netlify's Git-integration builds); only the CLI's local state dir is
# transient. Production web deploys still use Cloudflare (wrangler.toml).
.netlify/
**/.netlify/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
.vscode/
.idea/

# Downloaded fonts for scripts/generate-wordmark.mjs
scripts/.wordmark-cache/
.claude/worktrees/

# ui-preview skill output (local scratch images, not source)
scratchpad/
