# Supabase cloud sync/auth (Milestone 5+).
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Crash & error monitoring (Sentry). Monitoring is a no-op unless the DSN is
# set, so local/preview builds never report by accident. The DSN is a public
# client key (it ships in the app bundle), but is kept out of git by convention
# — set it in your local .env, the EXPO_PUBLIC_SENTRY_DSN CI/EAS secret, etc.
EXPO_PUBLIC_SENTRY_DSN=https://<publicKey>@o<org>.ingest.<region>.sentry.io/<projectId>
# Optional. Defaults to "development" when unset.
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional. 0..1 fraction of transactions sampled for performance tracing; 0 = off.
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Privacy-safe product analytics (optional). Analytics remains off until the
# user explicitly opts in under Settings. Use an EU-hosted PostHog project.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_public_project_key
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Full PostHog SDK (session replay, heatmaps, surveys, richer feature flags).
# Trial alongside Sentry — additive, default OFF at runtime (a separate
# Settings toggle from the analytics one above) and gated here at build time
# so it's inert until explicitly turned on for a build/channel. Reuses
# EXPO_PUBLIC_POSTHOG_API_KEY/_HOST above (same project).
# EXPO_PUBLIC_POSTHOG_FULL_SDK_ENABLED=true

# Build provenance (optional). Normally set automatically by the Android APK
# CI workflow from the commit it builds; shown in Settings → Build so an APK
# self-identifies. Leave unset for local/dev builds.
# EXPO_PUBLIC_GIT_SHA=
# EXPO_PUBLIC_GIT_REF=
# EXPO_PUBLIC_COMMIT_URL=

# ── ai-enrich edge-function secrets (server-side; NOT EXPO_PUBLIC) ────────────
# These are set with `supabase secrets set …`, not bundled into the app. Listed
# here only for discoverability; see supabase/functions/ai-enrich/README.md.
#   GEMINI_API_KEY            — enables the real model + rate limiting.
#   AI_ENRICH_TRIGGER_SECRET  — shared secret for the database server-trigger
#                               path; must equal the Vault `ai_enrich_secret`.
