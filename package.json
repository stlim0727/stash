{
  "name": "stash",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile bookmark app planning and implementation workspace.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "dev:android": "pnpm --filter mobile android",
    "dev:ios": "pnpm --filter mobile ios",
    "dev:web": "pnpm --filter mobile web",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "pnpm format:check && pnpm lint:env && pnpm lint:overlay",
    "lint:env": "node scripts/check-static-env.mjs",
    "lint:overlay": "node scripts/check-overlay-elevation.mjs",
    "test": "pnpm --filter mobile test && pnpm test:functions",
    "test:functions": "node --no-warnings --experimental-transform-types --test \"supabase/functions/**/*.test.ts\"",
    "typecheck": "pnpm --filter mobile typecheck",
    "verify:supabase": "node --no-warnings --experimental-transform-types scripts/verify-supabase.mjs",
    "verify:sentry": "node --no-warnings --experimental-transform-types scripts/verify-sentry.mjs",
    "sentry:issue": "node scripts/sentry-issue.mjs",
    "sentry:sync-github-issues": "node scripts/sentry-to-github-issues.mjs",
    "dedupe:supabase": "node --no-warnings --experimental-transform-types scripts/dedupe-bookmarks.mjs",
    "test:components": "pnpm --filter mobile test:components",
    "test:apptesting": "firebase apptesting:execute --app \"$FIREBASE_APP_ID\" --test-dir apps/mobile/apptesting --test-devices \"${FIREBASE_TEST_DEVICES:-model=shiba,version=34,locale=en,orientation=portrait}\""
  },
  "devDependencies": {
    "@supabase/realtime-js": "^2.110.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
