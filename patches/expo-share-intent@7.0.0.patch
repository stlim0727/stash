diff --git a/android/src/main/java/expo/modules/shareintent/ShareIntentDebugJournal.kt b/android/src/main/java/expo/modules/shareintent/ShareIntentDebugJournal.kt
new file mode 100644
index 0000000000000000000000000000000000000000..79d38fbc551d7a8899d655980bd8040a3ccf9614
--- /dev/null
+++ b/android/src/main/java/expo/modules/shareintent/ShareIntentDebugJournal.kt
@@ -0,0 +1,104 @@
+package expo.modules.shareintent
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import org.json.JSONArray
+import org.json.JSONObject
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import java.util.UUID
+
+/** Privacy-safe lifecycle evidence for the five most recent Android shares. */
+object ShareIntentDebugJournal {
+    private const val PREFS_NAME = "expo_share_intent_debug"
+    private const val JOURNAL_KEY = "attempt_journal"
+    private const val LEGACY_KEY = "last_intent"
+    private const val ATTEMPT_ID_EXTRA = "expo.modules.shareintent.DEBUG_ATTEMPT_ID"
+    private const val MAX_ATTEMPTS = 5
+
+    fun ensureAttemptId(intent: Intent): String? {
+        val existing = intent.getStringExtra(ATTEMPT_ID_EXTRA)
+        if (!existing.isNullOrBlank()) return existing
+        return UUID.randomUUID().toString().also { intent.putExtra(ATTEMPT_ID_EXTRA, it) }
+    }
+
+    @Synchronized
+    fun record(context: Context?, activity: Activity?, intent: Intent, phase: String): String? {
+        if (context == null) return null
+        val attemptId = ensureAttemptId(intent) ?: return null
+        try {
+            val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            val journal = try {
+                JSONArray(prefs.getString(JOURNAL_KEY, "[]") ?: "[]")
+            } catch (_: Exception) {
+                JSONArray()
+            }
+            var attempt: JSONObject? = null
+            for (index in 0 until journal.length()) {
+                val candidate = journal.optJSONObject(index)
+                if (candidate?.optString("attemptId") == attemptId) {
+                    attempt = candidate
+                    break
+                }
+            }
+            if (attempt == null) {
+                attempt = JSONObject().apply {
+                    put("attemptId", attemptId)
+                    put("capturedAt", now())
+                    put("action", intent.action ?: JSONObject.NULL)
+                    put("mimeType", intent.type ?: JSONObject.NULL)
+                    put("senderPackage", referrerPackage(activity, intent) ?: JSONObject.NULL)
+                    put("isTaskRoot", activity?.isTaskRoot ?: JSONObject.NULL)
+                    put(
+                        "isShareAction",
+                        intent.action == Intent.ACTION_SEND || intent.action == Intent.ACTION_SEND_MULTIPLE,
+                    )
+                    put("hasText", intent.hasExtra(Intent.EXTRA_TEXT))
+                    put("hasStream", intent.hasExtra(Intent.EXTRA_STREAM))
+                    put("phases", JSONArray())
+                }
+                journal.put(attempt)
+            }
+            attempt.getJSONArray("phases").put(JSONObject().apply {
+                put("phase", phase)
+                put("at", now())
+            })
+            while (journal.length() > MAX_ATTEMPTS) journal.remove(0)
+            prefs.edit().putString(JOURNAL_KEY, journal.toString()).apply()
+            return attemptId
+        } catch (_: Exception) {
+            return attemptId
+        }
+    }
+
+    @Synchronized
+    fun readAndClear(context: Context): String? {
+        return try {
+            val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            val value = prefs.getString(JOURNAL_KEY, null)
+            prefs.edit().remove(JOURNAL_KEY).remove(LEGACY_KEY).apply()
+            value
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun referrerPackage(activity: Activity?, intent: Intent): String? {
+        val fromIntent = intent.getParcelableExtra<android.net.Uri>(Intent.EXTRA_REFERRER)
+            ?: intent.getStringExtra(Intent.EXTRA_REFERRER_NAME)?.let { android.net.Uri.parse(it) }
+        val referrer = fromIntent ?: activity?.referrer ?: return null
+        return if (referrer.scheme == "android-app") {
+            referrer.host
+        } else {
+            "non-app:" + (referrer.scheme ?: "unknown")
+        }
+    }
+
+    private fun now(): String = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US).apply {
+        timeZone = TimeZone.getTimeZone("UTC")
+    }.format(Date())
+}
